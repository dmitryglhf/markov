crates/goose/src/agents/snapshots/*.snap linguist-language=Text

# The merge=ours / merge=theirs names below are NOT understood by git on
# their own — it ships no such drivers. scripts/upstream-merge-policy.sh
# applies them after the merge, and upstream-watch.yml runs it. A plain
# `git merge` by hand does not: run the script yourself afterwards.

# Lockfiles are never merged, they are regenerated: keep ours so the merge
# has no markers in them, then re-resolve against the merged manifests.
# Skipping that step leaves a lock that disagrees with Cargo.toml, which the
# --locked build in CI will catch.
flake.lock merge=ours
Cargo.lock merge=ours
ui/pnpm-lock.yaml merge=ours

# ours end to end, upstream's is about a different product
/README.md merge=ours

# desktop is frozen until upstream replaces Electron with Tauri; resolving
# conflicts in code we plan to throw away buys nothing
ui/desktop/** merge=ours

# CI here is ours end to end: our runners, our secrets, our artifact names,
# our signing gates. Upstream's edits describe their infrastructure, and the
# pieces they touch most are the ones this fork deleted outright.
.github/** merge=ours
